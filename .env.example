PRIMARY_API_KEY=sk-your-primary-api-key
PRIMARY_MODEL=deepseek-chat
PRIMARY_PROTOCOL=openai_compatible

# Optional Extended Providers (auto-probed on boot)
CLAUDE_BASE_URL=https://api.anthropic.com/v1
